{
  "name": "originary-website",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:all",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "check:emdash": "grep -R \"\\u2014\" app || true && test $(grep -R \"\\u2014\" app | wc -l) -eq 0",
    "verify:footer": "node scripts/verify-footer-links.mjs",
    "check:truth": "node scripts/check-protocol-truth.mjs",
    "check:securitytxt": "node scripts/check-security-txt.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "check:seo": "node scripts/seo-lint.mjs",
    "check:all": "npm run check:truth && npm run check:securitytxt && npm run check:ai-compliance && npm run test:ai-compliance && npm run check:machine-integrity && npm run test:machine-integrity && npm run check:routes && npm run check:redirects && npm run check:structured-data && npm run check:public-keys && npm run test:public-keys && npm run check:retired-endpoints && npm run test:retired-endpoints && npm run check:cli-pinning && npm run test:cli-pinning && npm run check:release-gate && npm run check:links && npm run check:snippets && npm run check:seo && npm run verify:footer",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:structured-data": "node scripts/check-structured-data.mjs",
    "check:public-keys": "node scripts/check-public-keys.mjs",
    "test:public-keys": "node scripts/check-public-keys.test.mjs",
    "test:proxy": "node scripts/proxy-gone.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:release": "npm run lint && npm run typecheck && npm run build && npm run test:proxy",
    "check:retired-endpoints": "node scripts/check-retired-endpoints.mjs",
    "test:retired-endpoints": "node scripts/check-retired-endpoints.test.mjs",
    "check:cli-pinning": "node scripts/check-cli-pinning.mjs",
    "test:cli-pinning": "node scripts/check-cli-pinning.test.mjs",
    "check:release-gate": "node scripts/check-release-gate.mjs",
    "check:machine-integrity": "node scripts/check-machine-integrity.mjs",
    "test:machine-integrity": "node scripts/check-machine-integrity.test.mjs",
    "check:ai-compliance": "node scripts/check-ai-compliance.mjs",
    "test:ai-compliance": "node scripts/check-ai-compliance.test.mjs",
    "check:facts": "node scripts/check-facts-freshness.mjs"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.35.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@microsoft/clarity": "^1.0.2",
    "@next/mdx": "^16.1.6",
    "@stripe/stripe-js": "^8.6.4",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.6.1",
    "@vercel/og": "^0.8.6",
    "clsx": "^2.1.1",
    "framer-motion": "^12.29.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-pretty-code": "^0.14.1",
    "rss": "^1.2.2",
    "shiki": "^3.21.0",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "playwright": "^1.58.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "packageManager": "npm@11.11.0"
}
